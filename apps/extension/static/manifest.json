{
  "manifest_version": 3,
  "name": "AI 翻译",
  "description": "右键用你自己的大模型（OpenRouter、DeepSeek 或任意 OpenAI 兼容接口）翻译网页，译文显示在原文下方。",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://openrouter.ai/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI 翻译设置"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
